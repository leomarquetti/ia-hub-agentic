# ==============================================================================
# AGENTIC OPS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT NOTICE:
# This repository is configured by default for PUBLIC PORTFOLIO DEMO MODE.
# In "portfolio" mode, ZERO API keys or database connections are required.
# All datasets, competitor entities, and tool responses run deterministically
# through in-memory synthetic fixtures.
#
# NEVER COMMIT REAL SECRETS, API KEYS, OR PRODUCTION TOKENS TO SOURCE CONTROL.
# ==============================================================================

# Application Runtime Mode: "portfolio" (default demo mode) | "private" (live integration)
NEXT_PUBLIC_APP_MODE=portfolio

# Optional Server-Side Secrets for Private Self-Hosted Deployments
# (These remain strictly server-side and are NEVER bundled into client browser code)
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private Playwright Scraping Adapter Configuration
ENABLE_PRIVATE_PLAYWRIGHT=false
SCRAPE_ALLOWED_DOMAINS=demo.local,synthetic.internal
